{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "description": "TS/Express 控制面（wayfinder #308 · issue #333 M0+M1）",
  "main": "dist/server/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run content:build && prisma generate",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/server/src/generated && cp -R src/generated dist/server/src/generated",
    "start": "node dist/server/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:apply": "node scripts/apply-schema.mjs",
    "export:neutral": "tsx scripts/export-neutral.mts",
    "content:build": "node scripts/build-official-content.mjs",
    "predev": "npm run content:build",
    "pretest": "npm run content:build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@langchain/anthropic": "~1.5.11",
    "@langchain/langgraph": "~1.4.18",
    "@langchain/langgraph-checkpoint": "~1.1.5",
    "@langchain/openai": "~1.6.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.10.1",
    "bullmq": "^6.0.5",
    "cookie-parser": "^1.4.7",
    "deepagents": "~1.14.1",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "langchain": "~1.5.14",
    "micromatch": "^4.0.8",
    "multer": "^2.4.0",
    "openwiki": "~0.6.1",
    "sharp": "^0.35.5",
    "shell-quote": "^1.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/config": "^7.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/shell-quote": "^1.7.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.22"
  }
}
