# 控制面服务环境变量（issue #333 M0+M1）
# 复制为 .env 并按需修改；.env 不入库（见仓库根 .gitignore）。

# JWT 签名密钥（HS256 对称）。生产必填强随机；留空则 dev 回退到不安全默认并告警。
JWT_SECRET=change-me-in-production

# 数据库（Prisma 7 driver adapter）。dev 默认 file:./prisma/panel.db。
DATABASE_URL=file:./prisma/panel.db

# access / refresh token 寿命（平移 simplejwt 默认 5m / 7d）
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=7d

# bcrypt cost（规格锁 12）
BCRYPT_COST=12

# bootstrap B1 首启管理员用户名（空表惰性生成）
BOOTSTRAP_ADMIN_USERNAME=admin

# 新建用户默认配额上限（#311 maxContainers）
DEFAULT_MAX_CONTAINERS=3

# 服务端口
PORT=8001

# 运行环境；非 production 时 refresh cookie 的 Secure 关闭（便于本地 http 调试）
NODE_ENV=development

# ── M2 容器编排（#334）──
# instances/<name>/ 落盘根（spec §5.6；仓库根 /fleet 已 gitignore）
FLEET_ROOT=./fleet
# cp -a 预填充源（共享只读模板，需 git clone ACautomata/researcher 与仓库并排；生产必填绝对路径）
OPENCLAW_TEMPLATE_DIR=
# openclaw.json 模板文件路径（配置单一来源 deploy/openclaw.json）
OPENCLAW_TEMPLATE_JSON=../deploy/openclaw.json
# 镜像 tag（官方 browser 变体，ADR 0003；生产建议 pin digest）
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-browser
# 全面板共享 LLM key（env 注入容器，不落盘）
LLM_API_KEY=
# 宿主端口池（池 [start,end]，容器内统一 18789；避开单容器 compose 占用的 18789）
PORT_POOL_START=19000
PORT_POOL_END=19999
# Redis（BullMQ provisioning 队列；stalled-job 崩溃重跑）
REDIS_URL=redis://127.0.0.1:6379
# BullMQ worker 并发（#313 锁：默认 2）
PROVISION_WORKERS=2
