# 控制面服务环境变量（issue #333 M0+M1）
# 复制为 .env 并按需修改；.env 不入库（见仓库根 .gitignore）。

# JWT 签名密钥（HS256 对称）。生产必填强随机；留空则 dev 回退到不安全默认并告警。
JWT_SECRET=change-me-in-production

# 数据库（Prisma 7 driver adapter）。dev 默认 file:./prisma/panel.db。
DATABASE_URL=file:./prisma/panel.db

# access / refresh token 寿命（平移 simplejwt 默认 5m / 7d）
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=7d

# bcrypt cost（规格锁 12）
BCRYPT_COST=12

# bootstrap B1 首启管理员用户名（空表惰性生成）
BOOTSTRAP_ADMIN_USERNAME=admin

# 新建用户默认配额上限（#311 maxContainers）
DEFAULT_MAX_CONTAINERS=3

# 服务端口
PORT=8001

# 运行环境；非 production 时 refresh cookie 的 Secure 关闭（便于本地 http 调试）
NODE_ENV=development

# ---- 控制面落盘根（#858 前身 fleet 落盘根；现役唯一消费方 = 附件上传临时区 <DATA_ROOT>/attachments）----
# 开发默认 <server>/data
# DATA_ROOT=/abs/path/data
# 平台默认端点共享 key（生产必填；用户 BYOK 凭证单独加密保存）
# LLM_API_KEY=
# BYOK 加密根（生产必填，≥32 字符；dev/test 默认值不适合生产）
# LLM_CREDENTIAL_SECRET=
# 六选一 minimax/anthropic/openai/deepseek/kimi/zhipu，默认 minimax
# LLM_PRESET=minimax
# 平台单模型覆盖（可选）
# LLM_MODEL=
# BullMQ/Redis 连接（runner run 队列）
# REDIS_URL=redis://localhost:6379/0

# ---- runner（#775，#747 F 节 · 731 §5）----
# 全局在飞 run 并发上限（进程内信号量；per-user 上限走 users.maxConcurrentRuns 列）。
# 满 40043。须正整数；默认 8。
# RUNNER_MAX_CONCURRENT_RUNS=8

# ---- AutoFigure 插件（#792）----
# 生成在 server 进程内执行；按用户在插件目录启用。生产启动校验必填键。
# AUTOFIGURE_IMAGE_MODEL=
# AUTOFIGURE_IMAGE_API_KEY=
# FAL_KEY=
# 可选生图端点（凭证仍由平台提供）。
# AUTOFIGURE_IMAGE_BASE_URL=
# 兼容期废弃键：设值启动告警；优先于插件 LLM 指派，失败不降级。
# 请清除此键并在模型配置页指派 AutoFigure；物理删除待独立兼容退役。
# AUTOFIGURE_SVG_MODEL=
