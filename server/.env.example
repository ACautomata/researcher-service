# 控制面服务环境变量（issue #333 M0+M1）
# 复制为 .env 并按需修改；.env 不入库（见仓库根 .gitignore）。

# JWT 签名密钥（HS256 对称）。生产必填强随机；留空则 dev 回退到不安全默认并告警。
JWT_SECRET=change-me-in-production

# 数据库（Prisma 7 driver adapter）。dev 默认 file:./prisma/panel.db。
DATABASE_URL=file:./prisma/panel.db

# access / refresh token 寿命（平移 simplejwt 默认 5m / 7d）
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=7d

# bcrypt cost（规格锁 12）
BCRYPT_COST=12

# bootstrap B1 首启管理员用户名（空表惰性生成）
BOOTSTRAP_ADMIN_USERNAME=admin

# 新建用户默认配额上限（#311 maxContainers）
DEFAULT_MAX_CONTAINERS=3

# 服务端口
PORT=8001

# 运行环境；非 production 时 refresh cookie 的 Secure 关闭（便于本地 http 调试）
NODE_ENV=development

# ---- 容器编排（#334 M2）----
# instances/<name>/ 落盘根（开发默认 <server>/fleet）
# OPENCLAW_FLEET_ROOT=/abs/path/fleet
# 共享只读 home 模板（cp -a 预填充源；生产必填绝对路径到 researcher 克隆）
# OPENCLAW_TEMPLATE_DIR=/abs/path/researcher
# openclaw.json 模板文件（配置单一来源）
# OPENCLAW_TEMPLATE_JSON=/abs/path/deploy/openclaw.json
# 镜像 tag
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-browser
# 端口池（避开单容器 compose 占用的 18789）
# OPENCLAW_PORT_POOL_START=19000
# OPENCLAW_PORT_POOL_END=19999
# 全面板共享 LLM_API_KEY（敏感值；生产必填，缺失时 create 返 90003）
# LLM_API_KEY=
# 容器 gateway 端口宿主侧发布地址（本地 127.0.0.1；生产后端容器化后 0.0.0.0）
# OPENCLAW_FLEET_PORT_BIND_HOST=127.0.0.1
# 健康探测目标 host
# OPENCLAW_FLEET_WS_HOST=127.0.0.1
# 面板对外 origin（#385）：隧道连容器网关的 WS Origin + 容器 allowedOrigins 强制条目（如
# https://panel.example.com）。生产必填，缺省/非法启动 fail-fast；dev 默认 127.0.0.1:18789
# （与网关默认 seed 一致，本地零配置）
# PANEL_PUBLIC_ORIGIN=https://panel.example.com
# 凭证加密密钥（gateway token 等真值落盘用 AES-256-GCM 密文）：逗号分隔 base64(32 字节)，首个 = active
# （加密新值），余者仅解密（密钥轮换：新密钥 prepend 为 active 后，旧密钥保留即可解历史行）。
# 生产必填（缺失时启动 fail-fast）；生成示例：openssl rand -base64 32
# CREDENTIAL_ENCRYPTION_KEYS=

# BullMQ worker 并发上限（默认 2）
# LIFECYCLE_WORKER_CONCURRENCY=2
# BullMQ/Redis 连接（后台 provisioning 队列）
# REDIS_URL=redis://localhost:6379/0
