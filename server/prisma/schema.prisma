// ============================================================================
// Prisma + SQLite 数据模型（wayfinder #310 草案 + #311/#328 扩展 · issue #333 落地）
//
// 来源：docs/research/310-prisma-schema-draft.prisma（已过 prisma validate）。
// 本期（M0/M1）扩展：User 新增 mustChangePassword / maxContainers（#311 C1 + #319 /me 要求，
// 310 草案 User 缺这两列）。其余 5 实体原样平移（容器/WIKI/桥接是后续切片，但 schema 一次落地）。
//
// 平移映射见 310 草案头部注释。目标 Prisma 7：generator=prisma-client（TS）+ driver adapter
// （@prisma/adapter-better-sqlite3），datasource 仅 provider、url 在 prisma.config.ts / PrismaClient。
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// User —— 账号实体（管理员 + 普通用户双角色）
//
// #311/#328 扩展（相对 310 草案）：
//   - mustChangePassword  bootstrap/重置/新建账号置 true（C1 强制改密）
//   - maxContainers       per-user 配额列（#858 容器 CRUD 退役后不再有「容器数」语义，仅剩 admin 可改的存量列面；列清退归终局票）
// ---------------------------------------------------------------------------
enum Role {
  admin
  user
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique // 登录名（Django UnicodeUsernameValidator 同语义）
  email              String?  @unique // 可空；OIDC 首登常以此为主键对齐
  passwordHash       String?  // bcrypt 散列；纯 OIDC 账号可空 → 应用层禁空密码登录
  role               Role     @default(user)
  isActive           Boolean  @default(true) // 平移 Django is_active（软禁用，不删行）
  mustChangePassword Boolean  @default(false) // #311 C1：首登/重置后强制改密
  maxContainers      Int      @default(3) // #311 配额；#858 容器 CRUD 退役后语义悬空（列+admin PATCH 面保留，清退归终局票）
  // --- #771（#747 B 节 · 731 §3.3 / 729 §3.5）---
  maxConcurrentRuns Int           @default(2) // per-user 在飞 run 配额（story 55；超限 40043）
  approvalMode      ApprovalMode  @default(standard) // 谨慎模式：cautious 下灰区强制升级人工（story 35）

  // --- OAuth2 预留（#311 O1 仅骨架；此处仅留形状）---
  oidcSubject String? // OIDC sub claim
  oidcIssuer  String? // OIDC issuer
  @@unique([oidcIssuer, oidcSubject]) // 同 issuer 下 sub 唯一（双可空时 SQLite 视为 distinct）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
  textTraceLogs   TextTraceLog[]
  figures         Figure[]
  // --- #771（#747 B 节）：LangGraph 新表关系 ---
  sessions         Session[]
  modelProviders   ModelProvider[] // 归属上移：provider 配置挂用户（731 §3.2）
  attachments      Attachment[]
  chaoxingBinding ChaoxingBinding?
  // --- Skill 市场（#1055 · #1054 D1–D5）---
  skillPackages   SkillPackage[]
  skillEnablements SkillEnablement[]
  chaoxingAuthorizations ChaoxingAuthorization[]
  pluginEnablements PluginEnablement[]
  pluginLlmAssignments PluginLlmAssignment[]
  historyRequestBudgets HistoryRequestBudget[]
  // --- reflections（#1080 RF-T04）---
  reflectionDrafts ReflectionDraft[]
  reflectionPresentations ReflectionPresentation[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// ApprovalMode —— 谨慎模式开关（#729 §3.5）：standard 常规三层漏斗 / cautious 灰区强制人工升级。
// ---------------------------------------------------------------------------
enum ApprovalMode {
  standard
  cautious
}

// ---------------------------------------------------------------------------
// TextTraceLog - generated-content provenance/audit records.
//
// Each completed assistant generation gets one row that links the final output
// to the triggering user, client IP, container/session/run, and a stable hash.
// The text itself is not modified; this supports the "content message" and
// "digital signature/hash" screenshots in the provenance sample document.
// ---------------------------------------------------------------------------
enum TextTraceStatus {
  success
  failed
}

model TextTraceLog {
  id            String          @id @default(cuid())
  traceId       String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  username      String
  ipAddress     String
  containerName String?
  sessionKey    String?
  runId         String?
  inputText     String          @default("")
  outputText    String          @default("")
  outputHash    String          @default("")
  status        TextTraceStatus @default(success)
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([status])
  @@map("text_trace_logs")
}

// ---------------------------------------------------------------------------
// RefreshToken —— refresh token 持久化（重写新增；现状 simplejwt 无状态、无表）
//
//   - tokenHash         存 sha256 散列不落明文（零信任）
//   - revokedAt         旋转或撤销时置位；旧 token 重放即判无效
//   - replacedByTokenId 旋转链：新 token 指回被它替换的旧 token（reuse 检测）
// ---------------------------------------------------------------------------
model RefreshToken {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tokenHash         String   @unique // 散列唯一索引：查找 + 防重
  expiresAt         DateTime
  revokedAt         DateTime? // null=有效；置位=已撤销/已旋转
  replacedByTokenId String? // 旋转链指针（R1 reuse 检测）

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// ModelProvider —— 一个用户的一个 LLM 端点（BYOK）行（#881 v16 换形）。
//
// 预设制：presetId ∈ 端点预设清单（models/presets.ts 六预设单一来源）——协议（wire 二值
// anthropic-messages|openai-completions）/ baseUrl / 凭证头策略全部随预设派生，无自由地址列
//（SSRF 构造性消灭；lcProvider/baseUrl/credentialEnvId/authHeader 旧列随 v16 退役）。
// credentialCipher 激活：AES-256-GCM v1 信封（models/cipher.ts，密钥 LLM_CREDENTIAL_SECRET）；
// NULL = 用平台共享 key（LLM_API_KEY）。明文 key 单向流：只在写请求出现，落库即密文。
// T0 #801 / v16 #881：旧形状行（containerId/api/apiKeyEnvId / v15 自由地址形状）由收敛段
// 检测即 copy-rebuild 或 DROP（#732 零迁移前提；v15→v16 见 incremental-schema v16 段）。
// ---------------------------------------------------------------------------
model ModelProvider {
  id          String    @id @default(cuid())
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String // users.id（归属上移，731 §3.2）

  providerId  String // 端点稳定 id；DNS-label（应用层校验）；保留域 'platform'（平台虚拟条目）写侧拒绝
  presetId    String // 端点预设清单 id（六预设；应用层校验成员资格）
  credentialCipher  String?  // BYOK key 密文（AES-256-GCM v1 信封）；NULL = 平台共享 key
  modelsJson  String // 模型条目数组 JSON 文本（id/name/reasoning/input/cost/contextWindow/maxTokens）

  createdAt DateTime @default(now())

  @@unique([ownerId, providerId])
  @@map("model_providers")
}

// ---------------------------------------------------------------------------
// Figure —— AutoFigure 用户可见领域资源（#744 v2 §5.1 换轨后形状）。
// 产物聚合语义：pipeline graph 成功终态一次性 create（ctx.figures 单写方法，#744 §11.1）——
// 执行状态机/超时/reconcile 归会话 run 域统一机制（GenerationJob 退役，#744 §5.2）。
// ownerId 只由认证的 researcher-service 身份（JWT）派生，永不来自客户端提交。
// V1 无 Figure 删除（owner 与 admin 均无），本模型不含删除/软删语义。
// ---------------------------------------------------------------------------
model Figure {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  prompt  String // 生成输入 = method_text（#744 §5.1；zod 校验后入库）

  // 产物（#744 §4.2/§5.1）：svg = final SVG 文本；png = 预览 PNG（渲染失败不致命 → 缺省 +
  // evaluation 元数据 previewReady=false 标记）；只持久化 final 产物，template/optimized/icons
  // 中间产物只在 graph 状态与事件流里 transient，不落库。
  svg String? // final SVG 文本
  png Bytes? // 预览 PNG（SQLite BLOB）

  // #744 §5.1：evaluation 列改存 pipeline 元数据（EvaluationMeta JSON：fix/optimize 迭代数、
  // 模型名、no_icon_mode 标记、渲染器标记；V1 仅审计不设限流 → 云 API 调用计数同落此处）。
  // 非敏感 JSON 载荷——绝不落 raw provider 响应/栈/凭证。
  evaluation String? // pipeline 元数据（文本 JSON）

  // #744 §5.1 新增溯源列：thread 内生成可回链；null = 机器面/未来其他入口。
  sessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("figures")
}

// ===========================================================================
// #771（#747·01）LangGraph agent runtime 新表地基 —— 会话历史域 + 审计域 + 配置域
//
// 逐字段依据：#747 B 节表 + 731/729/752/766/768/770 resolution。commands/skills 官方内容
// 目录不建表（#758 Q1/Q2/Q6 钉死 always-on 无表）。T0 #801 legacy 清退：Pairing 表已随设备
// 配对全链删除；ModelProvider 为 #771 新形状（旧形状行由 apply-schema 检测即 DROP 重建——
// 零迁移前提）。
// ===========================================================================

// ---------------------------------------------------------------------------
// Session —— 会话行（#727）：id = LangGraph thread_id（cuid，不编码），会话扁平挂用户
// （容器维度退役，story 4）。rewind/分支 = 换 activeCheckpointId 指针，消息行永不物理删。
// ---------------------------------------------------------------------------
model Session {
  id   String @id @default(cuid()) // = LangGraph thread_id（cuid，不编码 —— #727）
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // 绑定的会话沙箱 docker 容器名（researcher-sandbox-<sessionId>，#747 E 节；列名 containerId
  // 为历史遗留——T0 前存容器 id，T0 起存沙箱 docker 名）。
  // 无 FK：沙箱 docker 名由 sessionId 派生（sandboxContainerName 单一来源），落列仅省重复派生；
  // #858 容器行表退役后与 containers 表再无任何关联（本列从来不是它的 FK）。
  containerId String
  title       String @default("") // 自动生成可修改（story 5）；空串 = 未命名

  // fork 溯源（#727）：parentSessionKey = 源 session id；forkSourceJson = 切点 checkpoint 等。
  parentSessionKey String?
  forkSourceJson   String?

  // rewind/分支指针（#727）：指向 checkpoints 行（threadId = 本行 id）；换指针不删消息行，
  // 旧分支自然保留（checkpoint 树即分支真相源）。
  activeCheckpointId String?

  // 文件 rewind 水位（#782 · D8）：锚点时刻的 journal 最大 seq。逆放集 = seq > 水位 ∧
  // 行未处置（fileRevertedAt null）；崩溃续放判据（残集非空 → 续放，逆放幂等）。
  // scope=chat（只回对话文件保持现状）= 水位推进至当前 max（处置面永久跳过）。
  fileJournalAnchorSeq Int?

  // #787: /model is a session preference, applied at the next run snapshot.
  suggestionVersion Int @default(0)
  nextStepSuggestionJson String?
  suggestionSourceRunId String?
  preferredModelJson String?
  learningCourseId String?

  // #770：branch-switch 机制取消后，「先 fork 再回退」的被放弃原路线软删除存档
  // （delete 标记、映射层过滤——产品面不可读、行不物理删，retention/refcount GC 回收对象）。
  archivedAt DateTime?
  // Teammate threads use the same checkpoint store but stay out of the user's top-level session list.
  isTeammate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backgroundTasks BackgroundExec[]
  messages    SessionMessage[]
  checkpoints Checkpoint[]
  checkpointWrites CheckpointWrite[]
  attachments Attachment[]
  fileJournal FileJournal[]
  parentTeammates Teammate[] @relation("TeammateParent")
  teammateThread Teammate? @relation("TeammateThread")
  teammateMessages TeammateMailboxMessage[]
  teammateMailboxParentWaits TeammateMailboxWait[] @relation("MailboxWaitParent")
  teammateMailboxThreadWait TeammateMailboxWait? @relation("MailboxWaitThread")
  historyRequestBudgets HistoryRequestBudget[]
  reflectionDrafts ReflectionDraft[]
  reflectionPresentations ReflectionPresentation[]

  @@index([ownerId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Teammate —— a named agent thread owned by a parent session (#786).
// A teammate has its own Session row so LangGraph checkpoints and approvals remain isolated;
// that row is hidden from the top-level session list and remains archived after close.
// ---------------------------------------------------------------------------
model Teammate {
  id              String   @id @default(cuid())
  parentSession   Session  @relation("TeammateParent", fields: [parentSessionId], references: [id], onDelete: Cascade)
  parentSessionId String
  thread           Session  @relation("TeammateThread", fields: [threadId], references: [id], onDelete: Cascade)
  threadId         String @unique
  name             String
  task             String
  status           String   @default("requested")
  // #790（#747·20 · G 节三通道②）：teammate 类别——generic 缺省 / wiki-update = 治理生成
  // teammate（RunService 装配落地副本 backend + 生命周期工具 + 驱动提示；拓扑可由本列推导）。
  kind             String   @default("generic")
  modelProviderId  String?
  spawnedAtCheckpointId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  archivedAt       DateTime?

  messages TeammateMailboxMessage[]
  waits    TeammateMailboxWait[]

  @@unique([parentSessionId, name])
  @@index([parentSessionId, status])
  @@map("teammates")
}

// TeammateMailboxMessage —— durable point-to-point mail and request history (#786).
// recipientTeammateId=null addresses the leader. Invalidated messages remain auditable after rewind.
model TeammateMailboxMessage {
  id              String   @id @default(cuid())
  parentSession   Session  @relation(fields: [parentSessionId], references: [id], onDelete: Cascade)
  parentSessionId String
  senderTeammate  Teammate? @relation(fields: [senderTeammateId], references: [id], onDelete: SetNull)
  senderTeammateId String?
  recipientTeammateId String?
  kind            String   @default("message")
  content         String
  createdAt       DateTime @default(now())
  readAt          DateTime?
  invalidatedAt   DateTime?
  expiresAt       DateTime?

  @@index([parentSessionId, recipientTeammateId, createdAt])
  @@index([recipientTeammateId, readAt, invalidatedAt])
  @@map("teammate_mailbox_messages")
}

model TeammateMailboxWait {
  waitId                 String   @id
  parentSession          Session  @relation("MailboxWaitParent", fields: [parentSessionId], references: [id], onDelete: Cascade)
  parentSessionId        String
  thread                 Session  @relation("MailboxWaitThread", fields: [threadId], references: [id], onDelete: Cascade)
  threadId               String   @unique
  recipientTeammate      Teammate? @relation(fields: [recipientTeammateId], references: [id], onDelete: Cascade)
  recipientTeammateId    String?
  createdAt              DateTime @default(now())

  @@index([parentSessionId, recipientTeammateId])
  @@map("teammate_mailbox_waits")
}

// ---------------------------------------------------------------------------
// SessionMessage —— 消息投影行，产品读源（#727）：每 turn 聚合行（非 token 级——token 事件
// 即焚不落盘）。rewind/切换只动 Session 指针，本表行永不物理删（仅删会话级联清）。
// ---------------------------------------------------------------------------
model SessionMessage {
  id       String  @id @default(cuid())
  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  turn    Int    // 轮次序号（会话内单调，读路径排序键之一）
  role    String // user / assistant / system / tool …（值集应用层约定；D9 媒体方向由本列派生）
  content String @default("")

  // 客户端幂等 key（story 7 · #747 C 节 32-hex）：仅 user 行携带（POST /messages 落行时盖印）。
  // (sessionId, clientKey) 唯一 = 断网重发不重复入列的约束面（并发同 key 单落走 P2002 兜底
  // 重查，bootstrap 先例）；assistant/system 行恒 NULL——SQLite UNIQUE 多 NULL 视为 distinct，
  // 不参与幂等域。
  clientKey String?

  // attachmentsJson v1 聚合（schema 版本化，#726/#768）：
  // {v:1, thinking?, tools?[{toolCallId,name,input≤1k,result≤1k,state,durationMs,rejection?,details?≤4KB}],
  //  approval?, compaction?, media?:MediaRef[]}
  // 本票（#778）产出子集：{v:1, thinking?, tools?[{toolCallId,name,input,state,durationMs?,
  // details?,truncated?}]}——C 节 result 概念由 RunProjector details 承载（#777 事件目录
  // tool.end 无独立 result 字段，4KB 截断）；rejection/approval/compaction/media 归 #783
  // 审批漏斗及后续票（v1 契约全景见 serializeAttachments 演进）。
  attachmentsJson String @default("{\"v\":1}")

  // 用户消息锚点 = rewind 目标 checkpoint（story 16；换 activeCheckpointId 时定位）。
  // user 行：本票暂 NULL（attachment 上传 #780 时落值）；assistant 行：run 终态 checkpoint
  // 锚点（issue #778 点名——recordTurn 注入缝从 RunService StateSnapshot 取）。
  anchorCheckpointId String?

  // #770 rewind 软删存档：被放弃原路线的行打标记（映射层过滤——投影 GET 不读；行不物理删，
  // retention 回收对象）。fork 复制只拷活跃行，归档行不随 fork。
  archivedAt DateTime?

  createdAt DateTime @default(now())

  attachments Attachment[] // 挂载于本消息的附件（用户附件 + agent→用户媒体同表，D9）

  @@index([sessionId, turn])
  @@unique([sessionId, clientKey])
  @@map("session_messages")
}

// ---------------------------------------------------------------------------
// SessionHistoryVersion —— 历史读取变更版本（#1078 · RF-T02）。
// 每会话一个计数，由 prisma/history-triggers.sql 的 SQLite 触发器在「旧内容/可见性
// mutation」发生后与业务写入同事务递增：消息行 UPDATE/DELETE、归档行 INSERT、会话
// archivedAt/isTeammate 变化。普通消息追加（archivedAt=null 的 INSERT）与标题/模型设置
// 不递增——续读不因此失效。模型仅为 schema 权威登记；读写走历史域专用只读连接。
// ---------------------------------------------------------------------------
model SessionHistoryVersion {
  sessionId String  @id
  version   Int     @default(0)
  updatedAt DateTime @default(now())

  @@map("session_history_versions")
}

// ---------------------------------------------------------------------------
// HistoryRequestBudget —— 稳定主请求的历史检索额度账本（#1079 · RF-T03）。
// requestId = 可信 triggerMessageId（用户消息行 id），与可重建的 runId 分离；resume/recover
// 经本行延续，不重新发放。calls 在 reserve 时计入（失败/重试也算），bytes/waitedMs 交付前
// settle；行是「最小累计计量」，不含查询正文或书签。
// ---------------------------------------------------------------------------
model HistoryRequestBudget {
  requestId    String   @id
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  lastRunId   String
  calls       Int      @default(0)
  waitedMs    Int      @default(0)
  returnedBytes Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId, updatedAt])
  @@index([ownerId, updatedAt])
  @@map("history_request_budgets")
}

// ---------------------------------------------------------------------------
// Checkpoint / CheckpointWrite —— LangGraph 机制数据（#727；自定义 PrismaCheckpointSaver
// 五方法 put/putWrites/getTuple/list/deleteThread 的落点，#774 实现）。不暴露产品读。
// 形状对齐 LangGraph checkpoint 存储惯例（thread_id / checkpoint_ns / checkpoint_id 三元组）。
// ---------------------------------------------------------------------------
model Checkpoint {
  session    Session @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId   String // = Session.id（FK 级联：删会话清机制数据）
  checkpointNs       String @default("") // 子图命名空间
  checkpointId       String
  parentCheckpointId String? // checkpoint 树 = parent 链（分支真相源）
  type       String // LangGraph serializer type（如 "json"）
  blob       Bytes // 序列化 state（LangGraph dumpsTyped 字节；serde 默认 JSON —— #727）
  metadataJson String @default("{}")
  // #770 rewind 软删：被放弃原路线独有的 checkpoint 行打标记（retention/refcount GC 回收
  // 对象；机制面 LangGraph 不滤——activeCheckpointId 指针保证续跑永不触达归档分支）。
  archivedAt DateTime?
  createdAt  DateTime @default(now())

  @@id([threadId, checkpointNs, checkpointId])
  @@index([threadId, checkpointNs])
  @@map("checkpoints")
}

model CheckpointWrite {
  session  Session @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String
  checkpointNs String @default("")
  checkpointId String // 目标 checkpoint（Loose 引用：LangGraph pending writes 语义，不建 FK）
  taskId   String
  idx      Int
  channel  String
  type     String
  blob     Bytes // pending write 序列化字节

  @@id([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId, checkpointNs])
  @@map("checkpoint_writes")
}

// ---------------------------------------------------------------------------
// MemoryItem —— 跨会话长期记忆（BaseStore V1，#727）：PrismaMemoryStore 五方法
// get/put/delete/search/listNamespaces 落点（#774）。V1 无 embedding，前缀检索。
// 归属经 namespace 前缀（per-user）派生——刻意不建 user FK（#727：memory 跟 user 不级联）。
// createdAt（#774 补）：BaseStore Item 契约必填字段（put 时首记，跨会话记忆需知记忆成形时刻）。
// ---------------------------------------------------------------------------
model MemoryItem {
  namespace String // per-user 前缀（如 "user-<ownerId>"）
  key       String
  valueJson String
  createdAt DateTime @default(now()) // #774：Item.createdAt 契约（首写时刻，put 覆盖不刷新）
  updatedAt DateTime @updatedAt

  @@id([namespace, key]) // 复合主键左前缀即 namespace 索引（前缀检索走它）
  @@map("memory_items")
}

// ---------------------------------------------------------------------------
// ToolApprovalLog —— 审批三层漏斗全量审计（ADR 0015，729 §4.1 Prisma DDL 原文）：
// 规则/judge/人工三层同步写；judge 输入存 hash 不存全文；userId 冗余（无 FK）跟 user 永久。
// ---------------------------------------------------------------------------
enum ToolApprovalLayer {
  rule
  judge
  human
}

enum ToolApprovalDecision {
  allow
  deny
}

model ToolApprovalLog {
  id      String @id @default(cuid())
  traceId String // 弱关联 text_trace_logs.traceId（#727 双域接缝）
  runId   String
  userId  String // 冗余：审计快照跟 user 永久，不随容器/会话删（729 DDL 原文无 FK）
  layer   ToolApprovalLayer
  decision ToolApprovalDecision
  toolName String
  toolCall String // 规范化参数 JSON 快照
  policyClass String? // judge reject 的政策类（列拒四类之一）
  reason      String? // judge 理由 / 人工拒绝理由（用户可见）
  judgeInputHash String? // judge 输入快照 hash——不存全文，控体积
  latencyMs   Int? // judge 判定耗时（成本面，admin 可见）
  judgeTokens Int? // 输入+输出 token 成本（admin 可见）
  createdAt   DateTime @default(now())

  @@index([traceId])
  @@index([userId, createdAt])
  @@map("tool_approval_logs")
}

// ---------------------------------------------------------------------------
// PluginLlmAssignment —— per-user 插件 LLM 指派（#881 T1 建表备用，消费者归 #883）：
// 复合主键 ownerId+pluginId；pluginId 含保留键 'judge'（审批判定器指派行）。
// providerId NULL = 跟随默认链 / 'platform' = 钉平台默认端点 / 其余 ∈ 用户端点集；
// modelId 须属该端点模型集（应用层校验）。mutation 事务内 bump 配置版本（热生效）。
// ---------------------------------------------------------------------------
model PluginLlmAssignment {
  owner      User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  pluginId   String
  providerId String?
  modelId    String?
  updatedAt  DateTime @updatedAt

  @@id([ownerId, pluginId])
  @@map("plugin_llm_assignments")
}

// ---------------------------------------------------------------------------
// ConfigMeta —— 单行配置版本计数器（731 §3.3）：provider/endpoint CRUD 同事务 +1 =
// 热生效信号（runner run 启动读版本判等，不等才重载快照）。id 恒 = 1（CHECK 约束 Prisma
// DSL 不可表达 → 应用层不变量）；迁移脚本 INSERT OR IGNORE 种子首行。
// ---------------------------------------------------------------------------
model ConfigMeta {
  id      Int @id @default(1) // 单行：id 恒 = 1
  version Int @default(1)

  @@map("config_meta")
}

// ---------------------------------------------------------------------------
// LlmUsageRecord —— LLM usage 全量采数（#775 · #747 F 节 / story 57 成本核算数据源）。
// 行 = 一次 LLM 调用的 usage_metadata 落账（runner callback 采数，731 §3.2「记账真值改采
// usage_metadata」）；模型单价不入行（核算时 join modelsJson.cost——单价随配置版本可变，
// 行只存用量真值）。runId/sessionId 弱关联无 FK（审计快照跟 user 永久，不随 run/会话级联删，
// 对齐 TextTraceLog/ToolApprovalLog 纪律）；userId+username 冗余快照（改名不影响历史归属）。
// ---------------------------------------------------------------------------
model LlmUsageRecord {
  id        String  @id @default(cuid())
  runId     String // run 弱关联（无 FK）
  sessionId String? // 会话弱关联（独立 run 如 wiki 治理生成可无会话）

  userId   String // 冗余无 FK（tool_approval_logs 先例）
  username String // 冗余快照（user 改名不影响历史核算归属）

  providerId String // model_providers.providerId 弱引用
  lcProvider String // openai / anthropic（构造侧 provider 种类）
  model      String // 实际调用的 model id

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0) // usage_metadata.input_token_details.cache_read
  cacheWriteTokens Int @default(0) // usage_metadata.input_token_details.cache_creation

  createdAt DateTime @default(now())

  @@index([userId, createdAt]) // 核算查询：按用户 + 时间窗
  @@index([model, createdAt]) // 核算查询：按模型 + 时间窗（全局面）
  @@index([runId]) // per-run 对账下钻（#812 打捞；#777 接线后 per-run 核算）
  @@map("llm_usage_records")
}

// ---------------------------------------------------------------------------
// PluginEnablement —— per-user 插件启用位（752 §4.2）：复合主键 ownerId+pluginId；
// teammate 默认继承 owner 启用集 = per-run 快照。enabledAt 必填无默认（752 SQL 原文
// TEXT NOT NULL）——调用方显式置位。级联 users：面板 user 行级联先例（752 草图未钉级联语义）。
// ---------------------------------------------------------------------------
model PluginEnablement {
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  pluginId String
  enabled  Boolean @default(true)
  enabledAt DateTime

  @@id([ownerId, pluginId])
  @@map("plugin_enablements")
}

// ---------------------------------------------------------------------------
// Attachment —— 附件元数据（766 D1：字节在沙箱 /lab/uploads/<attachmentId>/<原始文件名>，
// 不进表）。id = attachmentId 雪花算法（时间有序，String 承载——64 位雪花超 int53）。
// agent→用户媒体与用户附件同表（方向由挂载消息 role 派生，不加列不分目录 —— D9）。
// fork 行全量复制不改 attachmentId（768 D7）→ 唯一域 = 会话内，主键复合 (sessionId, id)。
// ---------------------------------------------------------------------------
model Attachment {
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  id        String // attachmentId（雪花算法；fork 复制不改 → 会话内唯一）
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  message   SessionMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // 可空：766 D5 时序——上传端点先建元数据行、消息行后由投影引用 attachmentId（G 节 D5/D9：
  // 两条建行路径都是附件行先于消息行）；回填后非空。rewind 随消息同进退。
  messageId String?

  fileName String // 原始文件名（字节路径组成部分）
  mimeType String
  size     Int // 字节数（单文件 ≤100MB——D6，int32 内）
  sha256   String // 内容校验（ingestion 节点校验落库）
  path     String // 沙箱内路径 /lab/uploads/<attachmentId>/<原始文件名>

  @@id([sessionId, id])
  @@index([ownerId])
  @@index([sessionId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// FileJournal —— 文件 rewind 机制数据（766 D8）：session-global 全序（行 = checkpointId
// 锚点 + 全局 seq + op/path/前后 sha256 + tombstoneKey + toolCallId 幂等键 + applied 标记）。
// 崩溃管线 journal-first：行先落 applied=false → apply → 置位（启动/restore 双路 roll-forward
// reconcile 补 apply）；重放 = 全局序逆放（rewind 恢复 /lab 至锚点时刻，exec 显式降级不入日志）。
// fork 继承：源行复制、fork 时点截断、seq 接续（768 D7）→ 唯一域均收窄会话级：
//   (sessionId, seq) 全局序唯一 · (sessionId, toolCallId) 幂等唯一（D8 原文「toolCallId UNIQUE」
//   经 D7 修订后限会话内——fork 复制行不改 toolCallId，全局唯一与 D7 冲突，后 resolve 者为准）。
// ---------------------------------------------------------------------------
model FileJournal {
  id       String  @id @default(cuid()) // 内部代理主键：fork 复制行后仍逐行可寻址（审计引用）
  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  checkpointId String // op 生效锚点 checkpoint（rewind 预览/逆放定位）
  seq          Int // 会话内全局序（跨 thread——teammate 并发写同序；fork 时点截断、seq 接续）
  op           String // write / edit / delete（V1 值集应用层 + 测试锁定；rename 不在 V1 工具面）
  path         String // normalizeFilePath 后相对路径
  beforeSha256 String? // 前像 sha256（write 新文件无前像 → null）
  afterSha256  String? // 后像 sha256（delete 无后像 → null）
  tombstoneKey String? // 墓碑 key（daemon 侧 root 写 0700 隐藏目录；非墓碑行 null）
  toolCallId   String // 幂等键（journal-first 崩溃去重）
  // 打点所在 run（checkpointId 回填键：终态 recordTurn 按 runId 精确回填 anchorCheckpointId
  // ——'' 哨兵按会话回填会误伤并发 thread 的新 pending 行；runId 面无并发污染）。
  runId        String?
  applied      Boolean @default(false)
  // #770 rewind 软删：checkpointId 落在被放弃路线的行打标记（投影/继承面；fork 继承只拷活跃行）。
  archivedAt DateTime?
  // #782 行级处置标记：文件效果已处置（逆放完成 或 scope=chat 保持现状水位越过）。逆放集 =
  // seq > session.fileJournalAnchorSeq ∧ 本列 null；崩溃续放按同一判据（逆放幂等）。
  fileRevertedAt DateTime?

  @@unique([sessionId, seq])
  @@unique([sessionId, toolCallId])
  @@index([sessionId, checkpointId])
  @@map("file_journal")
}

// ---------------------------------------------------------------------------
// FileOverwriteLog —— teammate 并发写 write-after-write 覆盖审计（#785 · #747 E 节
// 「teammate 并发写互斥（#769 锁方案）」语义层）：取锁写 path 时存在已 applied 且上家
// writer ≠ 本 thread 的 file_journal 行 → 记一次（path/覆盖者/被覆盖者，不限时窗）。
// 观测面进审计域（D8 同纪律：静默失败不可接受），V1 覆盖合法、不做运行时提示。
// 弱关联无 FK（tool_approval_logs 审计快照先例——行跟审计域永久，不随会话删）；
// thread 身份存字符串快照（写者归属经 journal.checkpointId → checkpoints.threadId 解析
// 后落值，跨 fork/rewind 溯源不依赖 join）。
// ---------------------------------------------------------------------------
model FileOverwriteLog {
  id                  String @id @default(cuid())
  sessionId           String // 锁/journal 域会话（sandbox 所属 parent session）
  path                String // normalizeFilePath 后相对路径（lab/... | wiki/...，与锁 key 同约定）
  overwriterThreadId  String // 覆盖者 thread（本 thread；threadId = sessions.id 同构）
  overwrittenThreadId String // 被覆盖者 thread（journal 上家 writer）
  runId               String // 触发 run（弱关联）
  createdAt           DateTime @default(now())

  @@index([sessionId, path])
  @@index([createdAt])
  @@map("file_overwrite_logs")
}

// 超星资源授权独立于平台登录。generation 防止解绑后旧请求恢复授权。
model ChaoxingBinding {
  ownerId String @id
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  generation String
  tokenCipher String?
  expiresAt DateTime?
  coursesJson String?
  coursesSyncedAt DateTime?
  updatedAt DateTime @updatedAt
  @@map("chaoxing_bindings")
}

model ChaoxingAuthorization {
  stateHash String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  generation String
  verifierCipher String
  expiresAt DateTime
  @@index([ownerId])
  @@map("chaoxing_authorizations")
}

// ---------------------------------------------------------------------------
// Skill 市场（#1055 · #1054 D1–D5）：数据市场（纯 markdown 数据包，D2——zip 内仅白名单
// 静态资源，可执行件整包拒收）。字节落 DB BLOB（D3，figures 先例）：zip 解析校验通过后
// 按文件存 skill_files，下载端点重打包还原。V1 全员直发（D1），status 预留待审语义空间。
// ---------------------------------------------------------------------------
model SkillPackage {
  id           String @id // 雪花（attachments/snowflake 同一单点生成）
  name         String @unique // 全局唯一；管线层拒保留字（registry + 内置命令同源纪律）
  description  String
  category     String // 固定枚举（SKILL_CATEGORIES，管线层校验）
  uploaderId   String
  uploader     User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderRole String // admin | user（D1 来源记录，审计面）
  sha256       String // 整包 zip 内容校验
  status       String @default("published") // D1 V1 恒 published；预留待审语义空间
  publishedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  files SkillFile[]
  @@index([category])
  @@index([uploaderId])
  @@map("skill_packages")
}

model SkillFile {
  package SkillPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  path    String // zip 内相对路径（SKILL.md 恒在包根）
  mime    String
  size    Int
  sha256  String
  content Bytes

  @@id([packageId, path])
  @@map("skill_files")
}

model SkillEnablement {
  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  skillId  String
  enabled  Boolean @default(true)
  enabledAt DateTime @default(now())

  @@id([ownerId, skillId])
  @@index([skillId])
  @@map("skill_enablements")
}

// Durable shell executions belong to the sandbox's parent session; threadId retains
// the originating leader/teammate checkpoint identity. Never copied by fork.
model BackgroundExec {
  id String @id
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  threadId String
  ownerId String
  runId String
  toolCallId String
  command String
  container String
  runCommandJson String
  loopState String?
  state String @default("starting")
  background Boolean @default(false)
  delivery String @default("pending")
  stdout String @default("")
  stderr String @default("")
  truncated Boolean @default(false)
  exitCode Int?
  hardTimeoutMs Int
  logBytes Int
  createdAt DateTime @default(now())
  finishedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([sessionId, createdAt])
  @@index([state, delivery])
  @@map("background_execs")
}

// ===========================================================================
// #1080（RF-T04）reflections 域 —— 持久草稿 / 证据 / 展示 / 最小事件
//
// 本票只落地草稿链路（draft/present/read/cancel）；正式 record/revision 表与确认授权
// 归 #1081（RF-T05）与 #1082 之后。草稿无确认不得进入正式记录或 experience 检索——
// 本票的 search(experience) 恒无结果（无 record 表可查）。
//
// 设计要点（父规格 I3/I4/I5/I7）：
//   - 正文真源独立于工具 details：草稿正文存 contentJson，展示正文存 presentations.bodyJson；
//     工具/checkpoint/消息聚合只存 displayId/version/hash 引用。
//   - evidence 存原始来源定位（session/message/run/toolCallId/region/码点范围）+ 服务端
//     计算的 regionHash/contentVersion（不信任模型自填证明）。
//   - 展示绑定终态 assistant messageId（recordTurn 统一接缝回填；含 recover）。
//   - ack 与后续确认的单调序号由 reflection_events 的 AUTOINCREMENT 提供（同一 SQLite
//     单写服务模型，不靠同毫秒时间戳）。
// ===========================================================================

model ReflectionDraft {
  id        String  @id @default(cuid())
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  // 当前版本（实质修改 version 递增；旧展示随 present 撤销，见 service）。
  version   Int     @default(1)
  // preparing（含在飞/不可核验证据）| pending（全部证据可核验，可展示待确认）
  // | confirmed_pending_save | committed | rejected | expired | cancelled（后四者归 #1081+）
  status    String  @default("preparing")
  action    String  @default("create")
  title     String  @default("")
  category  String  @default("other")
  // 五部分正文快照（问题与影响/原因分析/改进建议/适用范围；原始证据存 reflection_evidence）
  contentJson String @default("{}")
  // 动作目标基准版本（revise/replace/merge 等；本票仅 create/revise 写入）
  targetsJson String?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence      ReflectionEvidence[]
  presentations ReflectionPresentation[]

  @@index([ownerId, sessionId])
  @@index([ownerId, status])
  @@map("reflection_drafts")
}

model ReflectionEvidence {
  id           String          @id @default(cuid())
  draft        ReflectionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId      String
  draftVersion Int
  position     Int
  ownerId      String
  sessionId    String
  messageId    String?
  runId        String?
  toolCallId   String?
  // content | thinking | tool_result
  region       String
  // Unicode 码点范围（null = 未指定，服务端按首次出现定位）
  startCp      Int?
  endCp        Int?
  excerpt      String
  // 服务端计算：区域原文 hash 与消息内容版本（不采信模型自填）
  regionHash   String?
  contentVersion String?
  // preparing（在飞待落行）| valid | not_ready（截断外/摘要/未解析）
  status       String
  reason       String?
  createdAt    DateTime        @default(now())

  @@unique([draftId, draftVersion, position])
  @@index([ownerId, messageId])
  @@index([messageId]) // #1084：来源变更触发器按 messageId 定位
  @@index([runId])
  @@map("reflection_evidence")
}

model ReflectionPresentation {
  displayId String @id @default(cuid())
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  draft     ReflectionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId   String
  draftVersion Int
  action    String
  // 完整展示正文（五部分 + 证据摘录）——聊天结构化块的实际渲染源；删除时随专属存储清理。
  bodyJson  String
  bodyHash  String
  // active（待 ack）| acked（客户端已完整渲染）| revoked（被新版本替代）| expired | deleted（正文已清）
  status    String @default("active")
  // 绑定终态 assistant 消息行（recordTurn 统一接缝回填；未绑定不可授权）
  messageId String?
  ackSeq    Int?
  // ack 时刻会话最大 turn（服务端单调序号）：确认消息 turn 必须更大才可能获得授权。
  ackTurn   Int?
  ackedAt   DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([ownerId, draftId])
  @@index([draftId]) // #1084：来源变更触发器按 draftId 撤销展示
  @@index([sessionId])
  @@map("reflection_presentations")
}

// ---------------------------------------------------------------------------
// ReflectionRecord / ReflectionRevision / ReflectionGrant / ReflectionIdempotency
// （#1081 · RF-T05）：正式记录 = 用户自然语言确认后的不可变版本存入；
// 授权绑定真实确认消息与展示，commit 只凭可信上下文查 grant，模型参数无 approved/token。
// ---------------------------------------------------------------------------

model ReflectionRecord {
  id      String @id @default(cuid())
  ownerId String
  // 发起会话（来源会话删除不级联删除已提交结论——本表不对 sessions 建外键）。
  sessionId String
  title     String
  category  String
  // 五部分正文快照（与不可变 revision 同步；正式记录的稳定副本）。
  contentJson String
  // active | inactive | superseded | deleted
  status String @default("active")
  // valid | review_required（来源失效退出主动使用；T08 完整闭环）
  evidenceStatus  String @default("valid")
  currentRevision Int    @default(1)
  generation      Int    @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  revisions ReflectionRevision[]
  evidence  ReflectionRecordEvidence[]

  @@index([ownerId, status])
  @@index([ownerId, updatedAt])
  @@map("reflection_records")
}

// #1084（RF-T08）：已提交记录的结构化证据引用——独立于发起会话（无 session/message 外键，
// 源会话删除不级联删除已提交结论；来源失效只把证据标 invalid 并让记录 review_required）。
model ReflectionRecordEvidence {
  id             String          @id @default(cuid())
  record         ReflectionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordId       String
  recordVersion  Int
  position       Int
  ownerId        String
  sessionId      String
  messageId      String?
  toolCallId     String?
  // content | thinking | tool_result
  region         String
  startCp        Int?
  endCp          Int?
  excerpt        String
  regionHash     String?
  contentVersion String?
  // valid | invalid（来源删除 / 内容变化 / 失权）；invalid 摘录不进入主动使用。
  status         String   @default("valid")
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([recordId, recordVersion, position])
  @@index([ownerId, sessionId, messageId])
  @@index([messageId])
  @@map("reflection_record_evidence")
}

// #1084（RF-T08）：可靠清理 outbox——源 mutation 与失效事实同事务入队（触发器/显式钩子），
// 读门先同步封锁；清理任务幂等重放直到 done，进程重启不遗漏。
model ReflectionCleanupOutbox {
  id        String   @id
  ownerId   String
  sessionId String
  messageId String?
  kind      String   @default("source_cleanup")
  // 待清理的来源摘录原文（独立副本：即便 evidence 行被级联删除仍可清理派生正文）。
  excerpt   String
  state     String   @default("pending")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, createdAt])
  @@index([messageId])
  @@map("reflection_cleanup_outbox")
}

model ReflectionRevision {
  id           String @id @default(cuid())
  recordId     String
  version      Int
  // 不可变版本正文 + 证据引用/摘录快照（旧版本只供管理读取，不主动使用）。
  bodyJson     String
  bodyHash     String
  evidenceJson String
  createdAt    DateTime @default(now())

  record ReflectionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, version])
  @@map("reflection_revisions")
}

model ReflectionGrant {
  id                    String @id @default(cuid())
  ownerId               String
  sessionId             String
  // 真实当前用户确认消息（稳定主请求身份）；一条消息最多一个完整动作。
  confirmationMessageId String
  displayId             String
  draftId               String
  draftVersion          Int
  bodyHash              String
  action                String
  // 展示 ack 的服务端单调序号（ack 必须早于确认消息）。
  ackSeq                Int
  // 10 分钟绝对到期（不续期）。
  expiresAt             DateTime
  // 提交尝试计数（最多 3 次，成功/失败都计入）。
  submissions           Int      @default(0)
  // active | consumed | revoked | expired
  status                String   @default("active")
  createdAt             DateTime @default(now())
  consumedAt            DateTime?

  @@unique([ownerId, confirmationMessageId])
  @@index([ownerId, draftId, status])
  @@index([draftId]) // #1084：来源变更触发器按 draftId 撤销未消费授权
  @@map("reflection_grants")
}

model ReflectionIdempotency {
  // `${ownerId}:${confirmationMessageId}`——同一确认消息只产生一个正式结果。
  key        String   @id
  ownerId    String
  recordId   String
  resultJson String
  createdAt  DateTime @default(now())

  @@index([ownerId])
  @@map("reflection_idempotency")
}

model ReflectionEvent {
  seq       Int      @id @default(autoincrement())
  ownerId   String
  objectId  String
  action    String
  version   Int?
  result    String
  category  String?
  createdAt DateTime @default(now())

  @@index([ownerId, objectId])
  @@map("reflection_events")
}
