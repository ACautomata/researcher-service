# 敏感配置（包含 API 密钥）
.env
.envrc

# 运行时产物
__pycache__/
*.pyc
*.pyo

# Legacy（旧 FastAPI 栈产物已从仓库删除；旧 checkout 本地仍可能残留，继续忽略防误提交）
pipeline.db
uploads/*
.server_pass

# IDE
.idea/

# 临时文件
*.log

# Claude Code —— skills/workflows/memory/agents 等配置随仓库版本化
# （.claude/ 不再全量忽略；敏感 session 文件由子目录各自的 .gitignore 控制）

# 本地虚拟环境 / pytest 缓存
.venv/
.pytest_cache/

# 前端（Vite）
node_modules/
dist/
.vite/
*.local

# backend 运行时数据库
backend/db.sqlite3
backend/db.sqlite3-journal

# server（新 Express 控制面，issue #333）
server/node_modules/
server/dist/
server/src/generated/
server/prisma/*.db
server/prisma/*.db-journal
server/.env

# 容器编排运行时数据（仓库根 fleet/：instances/<name>/ home + openclaw.json，spec §5）。
# 限仓库根（/ 前缀）——否则会误伤源码子包 containers/fleet/（issue #278）。
/fleet/

