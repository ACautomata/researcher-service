# deploy/.env.example —— 复制为 deploy/.env 后填写

# --- 必填 ---
# 网关 token：researcher openclaw.json 里 "${GATEWAY_TOKEN}" 占位符由此注入；
# 本仓库 FastAPI 调网关时也用同一值做 Bearer 认证。
GATEWAY_TOKEN=

# 模型 provider key（researcher 默认 minimax；经 SecretRef 运行时读，勿写进 openclaw.json）
LLM_API_KEY=

# --- 可选 ---
# LLM_BASE_URL=https://api.minimaxi.com/anthropic
# LLM_MODEL=minimax/MiniMax-M3

# researcher 仓库（ACautomata/researcher）在本机的克隆路径。
# 注意：相对路径解析基准是 compose 文件所在目录（deploy/），故指向仓库根须用 ../researcher。
# RESEARCHER_DIR=../researcher

# 镜像（默认 = 派生镜像钉版本 tag，见 deploy/README.md「派生镜像版本 tag 约定」，issue #695；
# 更强形式：pin digest）
# OPENCLAW_IMAGE=ghcr.io/acautomata/researcher-service/openclaw:2026.9.4-browser   # 派生镜像（issue #588：pdftotext + wiki/workspace 骨架）；可覆盖回官方基线

# 端口绑定地址（默认仅宿主 loopback；本仓库 FastAPI 经 http://127.0.0.1:18789 访问）
# DOCKER_BIND=127.0.0.1

# 网关 bind（lan = FastAPI 跨容器/宿主访问；同 network namespace 可 loopback）
# OPENCLAW_GATEWAY_BIND=lan

# 运行用户（默认 root：A3 delete cleanup 依赖 root chown；官方镜像以 node(1000) 跑，
# 收紧到 node 需配套重做 cleanup，ADR 0003 后续）
# OPENCLAW_RUN_USER=0:0

# --- 审批三层漏斗 judge（#783 · 729 §2.5，可选）---
# judge 独立小模型（haiku 4.5 级，与用户主模型解耦；key 复用 LLM_API_KEY）。
# 二者任缺 → judge 未启用，灰区工具调用一律升级人工审批（fail-closed）。
# RUNNER_JUDGE_MODEL=claude-haiku-4-5
# RUNNER_JUDGE_BASE_URL=https://api.anthropic.com
# RUNNER_JUDGE_LC_PROVIDER=anthropic
# 审批升级超时（默认 48h，毫秒；超时 run 转 suspended 非终态）
# RUNNER_APPROVAL_TIMEOUT_MS=172800000

# --- OpenAPI 文档面（#761，可选）---
# 域开关（默认开）：admin-only 文档面（/api/docs，zod 生成式 OpenAPI 3.1，requireAuth + requireAdmin
# 双层门控）。生产显式 false → server 不装配 docs 路由（/api/docs 整树 90005）。
# API_DOCS_ENABLED=true

# ---- AutoFigure 插件（#792）----
# 生成在 server 进程内执行；按用户在插件目录启用。生产启动校验必填键。
# AUTOFIGURE_IMAGE_MODEL=
# AUTOFIGURE_IMAGE_API_KEY=
# FAL_KEY=
# 可选：生图端点与 SVG 模型（未设时使用 owner 默认模型链）。
# AUTOFIGURE_IMAGE_BASE_URL=
# AUTOFIGURE_SVG_MODEL=
