# ====== AI API 配置 ======
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=sk-your-key
AI_MODEL=deepseek-v4-pro

# ====== Claude Agent SDK 配置 ======
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro
AGENT_AUTO_APPROVE=true

# ====== 服务配置 ======
HOST=127.0.0.1
PORT=8000
UPLOAD_DIR=./uploads
DB_PATH=./pipeline.db

# ====== arXiv 搜索（可选） ======
ARXIV_ENABLED=true

# ====== Obsidian Vault ======
OBSIDIAN_VAULT_PATH=./vault

# ====== OpenClaw 网关（可选） ======
# 开启后可使用 OpenClaw 单 main Agent（颖姗，科研助手）
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# 挂载进容器的精简版 openclaw.json 路径（配置单一来源），apply-config 写这里
RESEARCHER_CONFIG_PATH=./deploy/openclaw.json
# researcher 主 agent 的 workspace 根（上传文件落 {root}/oc-uploads）
RESEARCHER_WORKSPACE_PATH=./researcher/workspace
# researcher wiki 根（memory-wiki vault，wiki/main），Wiki 页读取这里
RESEARCHER_WIKI_ROOT=./researcher/wiki/main
# compose 栈工作目录（apply-config 后 docker compose restart 生效）
RESEARCHER_COMPOSE_DIR=./deploy
